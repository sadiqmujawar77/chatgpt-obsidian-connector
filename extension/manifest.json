{
  "manifest_version": 3,
  "name": "ChatGPT Obsidian Connector",
  "version": "0.1.0",
  "description": "Local-first connector for capturing ChatGPT conversations into Obsidian.",
  "permissions": [],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
